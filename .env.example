# KIS OpenAPI 자격증명 — https://apiportal.koreainvestment.com (실전투자 APP_KEY 발급)
# 이 파일을 .env 로 복사한 뒤 값을 채우세요. .env 는 gitignore 되어 커밋되지 않습니다.
KIS_APP_KEY=
KIS_SECRET_KEY=
KIS_ACC=            # 계좌번호 8자리 (뒤 상품코드 제외, 예: 12345678)

# --- 선택 ---
# KIS_DATA_DIR=     # 산출물 폴더 override (기본: repo 로컬 — db=kis/, JSON=create-report/public/data)
# FIN_REFRESH_DAYS= # 재무제표 재조회 주기(일, 기본 7)
