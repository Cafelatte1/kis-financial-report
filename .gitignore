# === 공통 ===
__pycache__/
*.pyc
.DS_Store

# === 자격정보/시크릿 (절대 커밋 금지) ===
**/.env
**/.data
**/jwt.txt
**/.token.json
**/service-account*.json
**/*-sa.json
**/gcp-key*.json

# === 산출물/로그 (개인정보 포함) ===
**/output*.csv
**/*.log
**/*.db

# === CAPTCHA 캡처물 (HTML 덤프에 계좌정보 포함 가능) ===
# 덤프는 모두 captcha/ 폴더에만 생성됨. (전역 *.html 금지 → create-report/index.html 등 소스가 빠지므로 금지)
**/captcha/

# === create-report (개인 금융데이터·빌드·스크린샷) ===
**/node_modules/
**/dist/
create-report/src/data/*.json
create-report/public/data/*.json
create-report/_shots/

# === app 빌드 산출물 (PyInstaller) ===
app/build/
app/dist/
**/*.exe
**/포트폴리오리포트_*.pdf
**/*리포트*.pdf

# === 파이썬 가상환경(전 폴더 공통) ===
**/.venv/

# === repo 미포함 폴더 (로컬에만 보관) ===
# captcha-recognizer: 구 스크래퍼용 ML(은퇴). financials-backend: 로컬 GCP deploy 용도
captcha-recognizer/
financials-backend/

# === data-etl mock 테스트 산출물 ===
